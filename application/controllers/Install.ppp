    // Helper method to check if a column exists
    private function column_exists($table, $column)
    {
        $query = $this->db->query("SHOW COLUMNS FROM `$table` LIKE '$column'");
        return $query->num_rows() > 0;
    }

    // Helper method to check if an index exists
    private function index_exists($table, $index)
    {
        $query = $this->db->query("SHOW INDEX FROM `$table` WHERE Key_name = '$index'");
        return $query->num_rows() > 0;
    }

    // Helper method to check if a foreign key exists
    private function foreign_key_exists($table, $constraint)
    {
        $query = $this->db->query("
            SELECT CONSTRAINT_NAME 
            FROM information_schema.TABLE_CONSTRAINTS 
            WHERE TABLE_SCHEMA = DATABASE()
            AND TABLE_NAME = '$table'
            AND CONSTRAINT_NAME = '$constraint'
            AND CONSTRAINT_TYPE = 'FOREIGN KEY'
        ");
        return $query->num_rows() > 0;
    }
